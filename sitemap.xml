permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {%- assign indexed_pages = site.pages | where: 'sitemap', true | sort: 'url' -%}
  {%- for indexed_page in indexed_pages %}
  <url><loc>{{ indexed_page.url | prepend: site.baseurl | prepend: site.production_url | xml_escape }}</loc></url>
  {%- endfor %}
</urlset>
